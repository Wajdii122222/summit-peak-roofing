# Whop credentials — NEVER commit real keys. On Whop hosting, set these with:
#   whop apps secrets set --secret WHOP_API_KEY=...
#   whop apps secrets set --secret WHOP_WEBHOOK_SECRET=...
# Locally, copy this file to .env and fill it in (sandbox keys for testing).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxxx
# Plan IDs for the two one-time products (create them in the Whop dashboard
# under Checkout links / Products, then paste the plan_... IDs into
# src/config.ts). Until they are set, checkout runs in demo mode and the
# estimate form offers an emailed invoice instead.
VITE_INSPECTION_PLAN_ID=plan_xxxxxxxxxxxxx
VITE_DEPOSIT_PLAN_ID=plan_xxxxxxxxxxxxx
# Port for the local API server (npm run server)
API_PORT=3001
